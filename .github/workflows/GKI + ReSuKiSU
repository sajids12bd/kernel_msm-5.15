name: "GKI+ReSuKISU+SuSFS"

env:
  OUT_DIR: "out"
  KERNEL_VERSION: "5.15"
  ANDROID_VERSION: "13"

on:
  schedule:
    #- cron: '0 0 * * 0'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-kernels:
    name: "🐎 Build YASK ${{ matrix.kernel.name }} kernel"
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        kernel:
          - name: "GKI"
            dir: "common_gki"
            repo_name: "common"
            repo_url: "https://android.googlesource.com/kernel/common"
            branch: "android13-5.15-lts"
            defconfig: "gki_defconfig"
            local_version: "-YASK-GKI"
            output_name: "Image.gki.ksu"
            enable_ksu: true
            extra_patches:
              - "https://raw.githubusercontent.com/topnotchfreaks/kernel_patches/main/0001-gki-fixup.patch"
              - "https://raw.githubusercontent.com/topnotchfreaks/kernel_patches/main/0001-scripts-sign-builds.patch"
              - "https://raw.githubusercontent.com/topnotchfreaks/kernel_patches/main/0001-scripts-Don-t-append-and-dirty-to-localversion.patch"
              - "https://raw.githubusercontent.com/topnotchfreaks/kernel_patches/main/0001-scripts-do-not-ship-full-auto_localversion.patch"
    env:
      KERNEL_LOC_DIR: ${{ matrix.kernel.dir }}
      KERNEL_NAME: ${{ matrix.kernel.repo_name }}
      KERNEL_REPO: ${{ matrix.kernel.repo_url }}
      KERNEL_BRANCH: ${{ matrix.kernel.branch }}
      DEFCONFIG_NAME: ${{ matrix.kernel.defconfig }}
      LOCAL_VERSION: ${{ matrix.kernel.local_version }}
      OUTPUT_NAME: ${{ matrix.kernel.output_name }}
      WORK_DIR: ${{ github.workspace }}

    steps:
      - name: "✨ Setup workspace"
        run: |
          mkdir -p ${{ env.KERNEL_LOC_DIR }}
          echo "BUILD_TIME=$(date +'%Y-%m-%d')" >> $GITHUB_ENV
          sudo apt-get update -qq
          sudo apt-get install -y repo rsync aria2 pahole dwarves

      - name: 📐 Setup SWAP 10GB
        uses: pierotofy/set-swap-space@master
        with:
          swap-size-gb: 10

      - name: 📐 Tune Swap
        run: |
          echo "vm.swappiness=80" | sudo tee -a /etc/sysctl.conf
          sudo sysctl -p

      - name: "🌟 Clone kernel source"
        working-directory: ./${{ env.KERNEL_LOC_DIR }}
        run: |
          git config --global http.postBuffer 524288000
          git config --global core.compression 0
          git config --global http.version HTTP/1.1

          for i in {1..5}; do
            git clone \
              --depth=1 \
              --filter=blob:none \
              --single-branch \
              --branch ${{ env.KERNEL_BRANCH }} \
              ${{ env.KERNEL_REPO }} \
              ${{ env.KERNEL_NAME }} && break

            echo "Retry $i/5"
            rm -rf ${{ env.KERNEL_NAME }}
            sleep 30
          done

      - name: "📥 Initialize AOSP repo and toolchains"
        working-directory: ${{ env.WORK_DIR }}
        run: |
          repo init -u https://android.googlesource.com/kernel/manifest -b common-android13-5.15-lts --depth=1
          repo sync --optimized-fetch --prune -j8
          rm -rf .repo
          rm -rf common

          aria2c -x 16 -s 16 -o prebuilts/clang/host/linux-x86/clang-r547379.tar.gz "https://github.com/topnotchfreaks/clang/releases/download/v1.0.0/clang-r547379.tar.gz"
          mkdir -p prebuilts/clang/host/linux-x86/clang-r547379
          tar -xzf prebuilts/clang/host/linux-x86/clang-r547379.tar.gz -C prebuilts/clang/host/linux-x86/clang-r547379
          rm -rf prebuilts/clang/host/linux-x86/clang-r547379.tar.gz

          rm -rf prebuilts/clang/host/linux-x86/clang-3289846
          rm -rf prebuilts/clang/host/linux-x86/clang-r450784e
          rm -rf prebuilts/clang/host/linux-x86/clang-stable

          sed -i \
           -e 's/^BRANCH=.*/BRANCH=android13-5.15/' \
           -e 's/^CLANG_VERSION=.*/CLANG_VERSION=r547379/' \
           ${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}/build.config.constants

          sed -i '/^POST_DEFCONFIG_CMDS="check_defconfig"/d' ${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}/build.config.gki || true

      - name: "🧩 Configure kernel & patches"
        working-directory: ${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}
        run: |
          CONFIG_FILE="arch/arm64/configs/${{ env.DEFCONFIG_NAME }}"
          echo "CONFIG_LOCALVERSION=\"${{ env.LOCAL_VERSION }}-${{ env.BUILD_TIME }}\"" >> "$CONFIG_FILE"
          echo "CONFIG_LOCALVERSION_AUTO=n" >> "$CONFIG_FILE"

          apply_patch() {
            local url="$1"
            local file=$(basename "$url")
            curl -L -o "$file" "$url"
            patch -p1 < "$file" || echo "::warning::Hunks failed in $file"
            rm -f "$file"
          }

          echo '${{ toJSON(matrix.kernel.extra_patches) }}' | jq -r '.[]' | while read p; do
            [ -n "$p" ] && apply_patch "$p"
          done

      - name: "🔧 Add BBG Support"
        if: matrix.kernel.enable_ksu == true
        working-directory: ./${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}
        run: |
          echo "Adding BBG..."
          wget -O- https://github.com/vc-teahouse/Baseband-guard/raw/main/setup.sh | bash
          echo "CONFIG_BBG=y" >> arch/arm64/configs/${{ env.DEFCONFIG_NAME }}
          sed -i '/^config LSM$/,/^help$/{ /^[[:space:]]*default/ { /baseband_guard/! s/selinux/selinux,baseband_guard/ } }' security/Kconfig

      - name: "🔧 Setup SukiSU-Ultra with SUSFS v2.0.0 + inline hooks"
        if: matrix.kernel.enable_ksu == true
        working-directory: ./${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}
        run: |
          set -e
      
          echo "🧹 Cleaning any previous KSU/SUSFS leftovers..."
          rm -rf ./KernelSU ./drivers/kernelsu ./SukiSU-Ultra ./susfs4ksu
      
          echo "📦 Cloning SUSFS (simonpunk dev branch for 5.15)..."
          if git clone --depth=1 https://gitlab.com/simonpunk/susfs4ksu.git -b gki-android13-5.15-dev susfs4ksu; then
            echo "✔ Cloned gki-android13-5.15-dev"
          else
            echo "::warning::dev branch clone failed, falling back to stable gki-android13-5.15"
            git clone --depth=1 https://gitlab.com/simonpunk/susfs4ksu.git -b gki-android13-5.15 susfs4ksu
          fi
      
          [ -d "susfs4ksu" ] || { echo "❌ SUSFS clone failed!"; exit 1; }
      
          echo "📄 Installing SUSFS source files..."
          mkdir -p fs include/linux
      
          cp -f susfs4ksu/kernel_patches/fs/* fs/ \
            && echo "✔ Copied fs/* from susfs4ksu" \
            || { echo "❌ Failed to copy susfs fs files!"; exit 1; }
      
          cp -f susfs4ksu/kernel_patches/include/linux/* include/linux/ \
            && echo "✔ Copied include/linux/* from susfs4ksu" \
            || { echo "❌ Failed to copy susfs headers!"; exit 1; }
      
          echo "🔧 Applying SUSFS kernel patch..."
          if [ -f "susfs4ksu/kernel_patches/50_add_susfs_in_gki-android13-5.15.patch" ]; then
            patch -p1 -ui susfs4ksu/kernel_patches/50_add_susfs_in_gki-android13-5.15.patch \
              && echo "✅ SUSFS patch applied" \
              || echo "::warning::SUSFS patch had issues, continuing..."
          else
            echo "::warning::50_add_susfs_in_gki-android13-5.15.patch not found, skipping"
          fi
      
          echo "🔧 Applying inline-hook patch..."
          if [ -f "susfs4ksu/kernel_patches/60_scope-minimized_manual_hooks.patch" ]; then
            patch -p1 -ui susfs4ksu/kernel_patches/60_scope-minimized_manual_hooks.patch \
              && echo "✅ Inline hook patch applied" \
              || echo "::warning::Inline hook patch had issues, continuing..."
          else
            echo "::warning::60_scope-minimized_manual_hooks.patch not found, skipping"
          fi
      
          rm -rf susfs4ksu
      
          echo "📦 Installing SukiSU-Ultra (v2-compatible)..."
          curl -LSs "https://raw.githubusercontent.com/ShirkNeko/SukiSU-Ultra/main/kernel/setup.sh" | bash -s susfs-v2
      
          if [ ! -L "drivers/kernelsu" ] && [ ! -d "drivers/kernelsu" ]; then
            echo "❌ ERROR: drivers/kernelsu was not created by setup.sh!"
            exit 1
          fi
          echo "✔ drive
          rs/kernelsu present"
      
          echo "📐 Adding KSU + SUSFS v2 configs..."
          CONFIG_FILE="arch/arm64/configs/${{ env.DEFCONFIG_NAME }}"
          python3 << 'PYEOF'
          configs = """
          CONFIG_KSU=y
          CONFIG_KSU_WITH_KPROBES=n
          CONFIG_KPROBES=y
          CONFIG_HAVE_KPROBES=y
          CONFIG_KPROBE_EVENTS=y
          CONFIG_OVERLAY_FS=y
          CONFIG_KSU_SUSFS=y
          CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
          CONFIG_KSU_SUSFS_SUS_PATH=y
          CONFIG_KSU_SUSFS_SUS_MOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
          CONFIG_KSU_SUSFS_SUS_KSTAT=y
          CONFIG_KSU_SUSFS_TRY_UMOUNT=y
          CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
          CONFIG_KSU_SUSFS_SPOOF_UNAME=y
          CONFIG_KSU_SUSFS_ENABLE_LOG=y
          CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
          CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
          CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
          CONFIG_KPM=y
          CONFIG_DEBUG_INFO_BTF=n
          """
          import os
          config_file = os.environ.get('CONFIG_FILE', 'arch/arm64/configs/gki_defconfig')
          with open(config_file, 'a') as f:
              f.write(configs.strip() + '\n')
          print("✔ SukiSU-Ultra + SUSFS v2 configs added")
          PYEOF
      
          echo "🎉 SukiSU-Ultra + SUSFS v2.0.0 + inline hooks integrated!"

      - name: "⚙️ Setup basic configs"
        working-directory: ${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}
        run: |
          CONFIG_FILE="./arch/arm64/configs/${{ env.DEFCONFIG_NAME }}"
          python3 << 'PYEOF'
          configs = """
          CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
          CONFIG_TCP_CONG_ADVANCED=y
          CONFIG_TCP_CONG_BIC=n
          CONFIG_TCP_CONG_WESTWOOD=y
          CONFIG_TCP_CONG_HTCP=n
          CONFIG_TCP_CONG_BBR=y
          CONFIG_DEFAULT_WESTWOOD=y
          CONFIG_OVERLAY_FS=y
          CONFIG_TMPFS_XATTR=y
          CONFIG_TMPFS_POSIX_ACL=y
          CONFIG_KALLSYMS=y
          """
          import os
          config_file = os.environ.get('CONFIG_FILE', 'arch/arm64/configs/gki_defconfig')
          with open(config_file, 'a') as f:
              f.write(configs.strip() + '\n')
          print("✅ Basic configs added")
          PYEOF

      - name: "📝 Append custom Makefile line"
        working-directory: ${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}
        run: |
          echo 'KBUILD_CFLAGS += -Wno-implicit-function-declaration' >> Makefile
          echo "Custom Makefile line added successfully"


      - name: "✅ Pre-build verification"
        if: matrix.kernel.enable_ksu == true
        working-directory: ./${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}
        run: |
          echo "========================================="
          echo "       PRE-BUILD VERIFICATION"
          echo "========================================="
          PASS=0
          FAIL=0

          check() {
            local desc="$1"
            local result="$2"
            if [ "$result" = "ok" ]; then
              echo "✔ $desc"
              PASS=$((PASS+1))
            else
              echo "❌ $desc"
              FAIL=$((FAIL+1))
            fi
          }

          # Check SukiSU-Ultra directory
          ( [ -d "SukiSU-Ultra" ] || [ -d "KernelSU" ] ) && check "SukiSU-Ultra/KernelSU directory exists" "ok" || check "SukiSU-Ultra/KernelSU directory exists" "fail"
          
          # Check symlink
          [ -f "drivers/kernelsu/Makefile" ] && check "drivers/kernelsu symlink valid" "ok" || check "drivers/kernelsu symlink valid" "fail"

          # Check SUSFS source files
          [ -f "fs/susfs.c" ] && check "fs/susfs.c present" "ok" || check "fs/susfs.c present" "fail"
          [ -f "include/linux/susfs.h" ] && check "include/linux/susfs.h present" "ok" || check "include/linux/susfs.h present" "fail"

          # Check ksu_late_loaded fix
          grep -q "ksu_late_loaded" drivers/kernelsu/core/init.c && \
            grep -q "bool ksu_late_loaded" drivers/kernelsu/core/init.c && \
            check "ksu_late_loaded declared in init.c" "ok" || \
            check "ksu_late_loaded declared in init.c" "fail"

          # Check app_profile fix
          grep -q "struct task_struct \*p = current" drivers/kernelsu/policy/app_profile.c && \
            check "app_profile.c p,t fix applied" "ok" || \
            check "app_profile.c p,t fix applied" "fail"

          # Check configs in defconfig
          CONFIG_FILE="arch/arm64/configs/${{ env.DEFCONFIG_NAME }}"
          grep -q "CONFIG_KSU=y" "$CONFIG_FILE" && check "CONFIG_KSU=y present" "ok" || check "CONFIG_KSU=y present" "fail"
          grep -q "CONFIG_KSU_SUSFS=y" "$CONFIG_FILE" && check "CONFIG_KSU_SUSFS=y present" "ok" || check "CONFIG_KSU_SUSFS=y present" "fail"
          grep -q "CONFIG_KPM=y" "$CONFIG_FILE" && check "CONFIG_KPM=y present" "ok" || check "CONFIG_KPM=y present" "fail"
          grep -q "CONFIG_KSU_WITH_KPROBES=n" "$CONFIG_FILE" && check "CONFIG_KSU_WITH_KPROBES=n present" "ok" || check "CONFIG_KSU_WITH_KPROBES=n present" "fail"
          grep -q "CONFIG_DEBUG_INFO_BTF=n" "$CONFIG_FILE" && check "CONFIG_DEBUG_INFO_BTF=n present" "ok" || check "CONFIG_DEBUG_INFO_BTF=n present" "fail"
          grep -q "CONFIG_OVERLAY_FS=y" "$CONFIG_FILE" && check "CONFIG_OVERLAY_FS=y present" "ok" || check "CONFIG_OVERLAY_FS=y present" "fail"

          # Check BBG
          grep -q "CONFIG_BBG=y" "$CONFIG_FILE" && check "CONFIG_BBG=y present" "ok" || check "CONFIG_BBG=y present" "fail"

          # Check no dangerous configs
          grep -q "CONFIG_KSU_SUSFS_SUS_SU=y" "$CONFIG_FILE" && \
            check "CONFIG_KSU_SUSFS_SUS_SU=y NOT present (dangerous)" "fail" || \
            check "CONFIG_KSU_SUSFS_SUS_SU=y not present (safe)" "ok"

          # Check Makefile custom flag
          grep -q "Wno-implicit-function-declaration" Makefile && \
            check "Custom Makefile flag present" "ok" || \
            check "Custom Makefile flag present" "fail"

          echo "=== KSU related configs in defconfig ==="
          grep "KSU\|KPROBES" "$CONFIG_FILE" | head -20

          echo "========================================="
          echo "  PASSED: $PASS  |  FAILED: $FAIL"
          echo "========================================="

          if [ $FAIL -gt 0 ]; then
            echo "❌ Verification failed — fix issues before building!"
            exit 1
          else
            echo "✅ All checks passed — safe to build!"
          fi



      - name: "🔨 Build kernel"
        working-directory: ${{ env.WORK_DIR }}
        run: |
          LTO=full \
          BUILD_CONFIG=${{ env.KERNEL_LOC_DIR }}/${{ env.KERNEL_NAME }}/build.config.gki.aarch64 \
          build/build.sh -j$(nproc --all)

      - name: "📁 Copy kernel image"
        working-directory: ${{ env.WORK_DIR }}/out/dist
        run: |
          cp Image "${{ env.OUTPUT_NAME }}"

      - name: "📤 Upload kernel artifact"
        uses: actions/upload-artifact@v4.6.2
        with:
          name: ${{ matrix.kernel.name }}-kernel
          path: ${{ env.WORK_DIR }}/out/dist/${{ env.OUTPUT_NAME }}
          retention-days: 1

  package-kernels:
    name: "📦 Package Kernels"
    runs-on: ubuntu-latest
    needs: [build-kernels]
    steps:
      - name: "📥 Download kernel artifacts"
        uses: actions/download-artifact@v4.3.0
        with:
          path: ./artifacts/

      - name: "📦 Create release package"
        run: |
          set -e

          # Clone AnyKernel3
          git clone --depth=1 https://github.com/sajids12bd/AnyKernel3 -b master AnyKernel3

          # Copy kernel images
          find ./artifacts -name "Image.*" -exec cp {} AnyKernel3/ \;

          # Create ZIP
          ZIP_NAME="Anykernel3_YASK-SukiSU-Ultra-CLO_$(date +'%Y-%m-%d').zip"
          cd AnyKernel3
          zip -r9 "../$ZIP_NAME" * -x .git/*
          cd ..

          echo "ZIP_NAME=$ZIP_NAME" >> $GITHUB_ENV
          echo "✅ Package created: $ZIP_NAME"

      - name: "⬆️ Upload to GitHub Release"
        uses: softprops/action-gh-release@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GH_TOKEN }}
        with:
          files: ${{ env.ZIP_NAME }}
          tag_name: "YASK-NEXT"

      - name: "📱 Send Telegram Notification"
        run: |
          RELEASE_URL="https://github.com/${{ github.repository }}/releases/tag/YASK-NEXT"
          BANNER_URL="https://raw.githubusercontent.com/topnotchfreaks/kernel_msm-5.15/builder/assets/yask.png"

          if [[ "${{ job.status }}" == "success" ]]; then
            MESSAGE="✅ *YASK Kernel Released*

          📦 *Build Information:*
          • Kernel: \`Linux 5.15\`
          • Android: \`13-16\`
          • Base: \`GKI & CLO\`
          • KSU: \`SukiSU-Ultra\`
          • SUSFS: \`Enabled (GKI A13-5.15)\`
          • LTO: \`Full\`
          • Optimization: \`-O2\`
          • BBG: \`Enabled\`

          📱 *Supported Devices:*
          • Redmi Note 12 4G/NFC
          • Redmi Note 13 4G/NFC
          • Redmi Pad SE

          📱 *Supported Manager:*
          • KSU by tiann
          • KSU by sidex15
          • Wild-KSU
          • KernelSU-Next
          • Rissu-KSU
          • KowSU
          • SukiSU-Ultra

          🕐 *Build Date:* $(date '+%Y-%m-%d %H:%M:%S UTC')
          📦 *Package:* \`${{ env.ZIP_NAME }}\`

          ⬇️ [Download Here]($RELEASE_URL)"

            curl -s -X POST \
              -d chat_id=${{ secrets.TELEGRAM_CHANNEL_ID }} \
              -d photo="${BANNER_URL}" \
              --data-urlencode "caption=${MESSAGE}" \
              -d parse_mode="Markdown" \
              -d disable_web_page_preview="false" \
              "https://api.telegram.org/bot${{ secrets.TELEGRAM_YASK_BOT_TOKEN }}/sendPhoto"

          else
            FAILURE_MSG="❌ *YASK Kernel Build Failed*

          📦 *Build Information:*
          • Kernel: \`Linux 5.15\`
          • Android: \`13-16\`
          • Base: \`GKI & CLO\`
          • KSU: \`SukiSU-Ultra\`
          • SUSFS: \`Enabled (GKI A13-5.15)\`
          • LTO: \`Full\`
          • Optimization: \`-O2\`
          • BBG: \`Enabled\`

          🕐 *Failed at:* $(date '+%Y-%m-%d %H:%M:%S UTC')

          🔍 Check the [workflow logs](https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}) for details."

            curl -s -X POST \
              -d chat_id=${{ secrets.TELEGRAM_CHANNEL_ID }} \
              -d photo="${BANNER_URL}" \
              --data-urlencode "caption=${FAILURE_MSG}" \
              -d parse_mode="Markdown" \
              "https://api.telegram.org/bot${{ secrets.TELEGRAM_YASK_BOT_TOKEN }}/sendPhoto"
          fi
